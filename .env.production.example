# Copy this file to .env.production and replace every change-me value.
DOMAIN=crm.example.com
LETSENCRYPT_EMAIL=admin@example.com

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
APP_URL=https://crm.example.com
LANGUAGE_CODE=en
TIME_ZONE=UTC

DB_NAME=sails_crm
DB_USER=sails_crm
DB_PASSWORD=change-me-to-a-strong-database-password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
# Enable HSTS only after HTTPS works correctly for the final domain.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

SUPPORT_EMAIL=support@example.com
ADMIN_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=Sails CRM <crm@example.com>
SERVER_EMAIL=Sails CRM <crm@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=crm@example.com
EMAIL_HOST_PASSWORD=change-me
