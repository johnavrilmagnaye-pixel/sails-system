# Public application URL used in notification templates.
APP_URL=http://localhost:8000

# Public support address and recipient for internal error reports.
SUPPORT_EMAIL=support@example.com
ADMIN_EMAIL=admin@example.com

# Sender addresses. Values may include a display name, for example:
# DEFAULT_FROM_EMAIL=Sails CRM <crm@example.com>
DEFAULT_FROM_EMAIL=crm@example.com
# Optional per-message senders. Each falls back to DEFAULT_FROM_EMAIL.
# WELCOME_FROM_EMAIL=Sails CRM <welcome@example.com>
# NOTIFY_FROM_EMAIL=Sails CRM <notifications@example.com>
# REMIND_FROM_EMAIL=Sails CRM <reminders@example.com>
SERVER_EMAIL=crm@example.com

# SMTP credentials (used by Django email backends).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=crm@example.com
EMAIL_HOST_PASSWORD=change-me
